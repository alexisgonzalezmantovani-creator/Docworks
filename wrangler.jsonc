{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docworks",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "docworks.com.ar",
      "custom_domain": true
    },
    {
      "pattern": "www.docworks.com.ar",
      "custom_domain": true
    }
  ]
}
